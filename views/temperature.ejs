<%- include('../templates/header.ejs',{title:title})%>
<body>
  <div>
    <main>

      <h1 class="text-center text-2xl font-bold mt-5"><%= title %> conversion page</h1>
     <div class="flex flex-col justify-center items-center">

     
      
      <form id="temperature-form" 
      class="
      flex flex-col m-10 h-[350px] w-[350px] justify-center items-center rounded-md bg-gray-50
      ">
        <label class='text-lg font-bold' for="targetnum">enter a value:</label>
        <input
        class="w-[50%] my-2 h-[35px] rounded-md border-md focus:bg-sky-100" 
        name="targetnum" 
        id="targetnum" 
        type="text" 
        aria-placeholder="enter a value" 
        placeholder="enter a value"
        value=""
        />

        <label class='text-lg font-bold' for="tempFrom">from:</label>


        <select 
           id='tempFrom'  
           name="tempFrom" required
           class="my-2 rounded-md border-md h-[35px] focus:bg-sky-100" 
           >
          <option value="">Select an option </option>
          <option value="celsius">celsius(C)</option>
          <option value="farenheit">farenheit(F)</option>
        </select> 

        <label class="text-lg h-[35px] font-bold" for="tempTo">to:</label>
        <select id="tempTo" name="lengthTo" required>
          <option value="">Select an option </option>
          <option value="celsius">celsius(C)</option>
          <option value="farenheit">farenheit(F)</option>
        </select>

        <button class="bg-blue-700 text-neutral-50 
        w-20 h-10 text-md mt-5 rounded-md font-semibold mx-auto">submit</button>

        </form>

      

          <div class="result my-10 text-center text-lg font-semibold">

        </div>
      
        <button class="reset-btn bg-red-500 text-neutral-50 
        w-20 h-10 text-md rounded-md font-semibold mx-auto
        ">reset</button>

         </div>

        <script>

       
        
        const celsiusToFarenheit=(num)=>{
          return (num*1.8)+32
        } 

        const farenheitToCelsius=(num)=>{
          return (num - 32) /1.8
        } 
        
      

       

        let form=document.getElementById('temperature-form')
        form.addEventListener('submit',(event)=>{
          event.preventDefault()
          let num=event.target.targetnum.value;
          if(num===""){
            alert("please enter a number")
            return
          }
          
          if(event.target.tempFrom.value==='celsius'){
              
                let result=celsiusToFarenheit(parseFloat(num));
                document.querySelector(".result").textContent=`${parseFloat(num)} C is ${result} F`
          }
              
          
          if(event.target.tempFrom.value==='farenheit'){
                let result=farenheitToCelsius(parseFloat(num));
                document.querySelector(".result").textContent=`${parseFloat(num)} F is${result} C`
              }
        

      
      
      })


      let reset=document.querySelector('.reset-btn');
      let tempToSelectbox=document.querySelector('#tempTo');
      let tempFromSelectbox=document.querySelector('#tempFrom');
      let result=document.querySelector('.result')
      let enterednum=document.querySelector("#targetnum");

      reset.addEventListener('click',()=>{
        enterednum.value=''
        result.textContent='';
        tempFromSelectbox.value='';
        tempToSelectbox.value='';
        alert('form cleared')

      })
    

      </script>

      
   </main>
</div>
    
</body>
</html>